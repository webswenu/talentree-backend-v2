# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=talentree_user
DB_PASSWORD=talentree_password
DB_DATABASE=talentree_db
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_DROP_SCHEMA=false

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRATION=7d

# ============================================
# CACHE CONFIGURATION
# ============================================
CACHE_TTL_MS=300000
CACHE_MAX=1000

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================
# EMAIL CONFIGURATION
# ============================================
MAIL_USER=
MAIL_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@talentree.com

# ============================================
# FRONTEND URL
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# AWS S3 CONFIGURATION
# ============================================
# RECOMENDADO. Sin estas variables la aplicación ARRANCA igual (corregido en
# P-20; antes el constructor de S3Service lanzaba una excepción que tumbaba el
# backend completo), pero el almacenamiento de archivos queda desactivado: las
# subidas y descargas de informes, logos, CV y videos responden 503 con un
# mensaje que indica qué variable falta. No hay respaldo en ./uploads.
#
# Para desarrollo local, levantar MinIO (habla el mismo protocolo que S3):
#   docker run -d --name talentree-minio -p 9000:9000 -p 9001:9001 \
#     -e MINIO_ROOT_USER=talentree -e MINIO_ROOT_PASSWORD=talentree123 \
#     -v talentree-minio-data:/data minio/minio:latest server /data --console-address ":9001"
# y crear el bucket desde la consola web (http://localhost:9001).
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=talentree-bucket

# Endpoint alternativo compatible con S3. Déjalo VACÍO para usar el S3 real de
# AWS; defínelo (por ejemplo http://localhost:9000) para apuntar a MinIO.
AWS_S3_ENDPOINT=
